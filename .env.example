# Telegram Bot Sozlamalari
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=@s_legenda_bot

# DeepSeek AI sozlamalari
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash

# Ixtiyoriy zaxira (DeepSeek ishlamasa)
GLM_API_KEY=your_glm_api_key_here
GLM_MODELS=glm-4.7,glm-4.6

# Ixtiyoriy Tavily qidiruv kalitlari (internetdan faktik ma'lumot olish uchun)
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=

# Rasmlar papkasi (profil rasmi uchun)
MEMES_DIR=Memes

# Xotira va kontekst limitlari
MAX_CONTEXT_TOKENS=100000
CONTEXT_MESSAGES_LIMIT=8

# AI API chaqiruv parametrlari
AI_TEMPERATURE=0.55
AI_MAX_TOKENS=130
AI_FREQUENCY_PENALTY=0.5
AI_PRESENCE_PENALTY=0.3

# Guruh cheklovi: bot faqat shu ID dagi guruhda ishlaydi (0 — barcha guruhlarda)
# Joriy guruh ID sini bilish uchun guruhda /chatid buyrug'ini yozing
ALLOWED_GROUP_ID=0

# Bot yaratuvchisi (kim yaratgan deb so'ralganda ko'rsatiladi)
CREATOR_NAME=Muhammadaziz
CREATOR_USERNAME=@muhammadaziz

# Bot Administratorlari ID lari (ixtiyoriy, vergul bilan: 12345678,87654321)
ADMIN_IDS=
